# Copy this file to .env and fill in real values. Never commit .env itself.

# Neon Postgres connection string (Neon dashboard → your project → Connect)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Google Sheets sync (server-only — never exposed to the browser).
# 1. Create a Service Account in Google Cloud Console.
# 2. Grant it "Editor" access to your target spreadsheet.
# 3. Create a JSON key, then extract these two fields from the JSON file:
GOOGLE_SERVICE_ACCOUNT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
